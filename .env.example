# Copy to .env on the VPS (chmod 600). Never commit the real file.

# MySQL runs on the VPS host; the container reaches it via host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=jksutauf_nesidb
DB_USER=nesi_scraper
DB_PASSWORD=

# Optional: healthchecks.io ping URLs; you get an alert when a run fails or is missed.
HEALTHCHECK_URL_GENCO=
HEALTHCHECK_URL_DISCO=

# Email via Resend (off while RESEND_API_KEY or REPORT_FROM is empty).
# REPORT_TO is optional: extra report recipients beyond the site's people list.
RESEND_API_KEY=
REPORT_FROM=NESI Reports <reports@raven-emrc.com>
REPORT_TO=
# REPORT_HOURS=0,9,12,15,18,21   # Nigeria-time hours to email a report

# Re-run button. Without PUBLIC_BASE_URL the button opens the GitHub "Re-run scrapers" workflow.
PUBLIC_BASE_URL=https://nesi-alert.raven-emrc.com
# Generate with: openssl rand -hex 32
RERUN_SECRET=
# Owner email(s) for the re-run site; they add everyone else there.
DASHBOARD_USERS=

# Optional tuning (defaults shown).
# RUN_MINUTE=5                    # minute past each hour (UTC) the jobs start
# JOB_TIMEOUT_SECONDS=900         # hard limit per job run
# GENCO_REVALIDATE_UNTIL_HOUR=7   # before this Nigeria hour, also re-scrape yesterday
# LOG_LEVEL=INFO
